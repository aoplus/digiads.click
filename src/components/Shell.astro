---
// Industry pages use the same layout as Program and About (Base): same header, menu, fonts and footer.
// The page templates keep their own class names; the styles below map them onto Base's palette, scoped under .vp.
import Base from './Base.astro';
const { title, description, jsonld = [] } = Astro.props;
---
<Base title={title} description={description}>
  <main class="vp"><div class="wrap">
    {jsonld.map((j) => <script type="application/ld+json" is:inline set:html={JSON.stringify(j)} />)}
    <slot />
  </div></main>
  <script src="https://shop.digiads.click/buy.js" defer></script>
</Base>
<style is:global>
.vp{--accent:var(--blue)}
.vp section{padding:34px 0}
.vp h1{font-size:clamp(2rem,4.6vw,3.4rem);line-height:1.05;letter-spacing:-.05em;margin:14px 0}
.vp h2{font-size:clamp(1.5rem,3vw,2.1rem);line-height:1.1;letter-spacing:-.04em;margin:0 0 12px}
.vp h3{margin:8px 0;font-size:1.02rem}
.vp p{color:var(--muted)} .vp .lead{max-width:720px}
.vp .crumbs{padding:6px 0 0;font-size:.85rem;color:var(--muted)} .vp .crumbs a{color:var(--blue)}
.vp .hero.left{background:var(--soft);color:var(--ink);padding:44px 34px;border-radius:20px;margin-top:10px}
.vp .hero.left p{color:var(--muted);font-size:1.08rem;max-width:720px}
.vp .pill{display:inline-block;color:var(--purple);font-weight:800;text-transform:uppercase;letter-spacing:.1em;font-size:.73rem}
.vp .cta{display:flex;gap:12px;flex-wrap:wrap;margin-top:22px;background:none;border-radius:0;padding:0;color:inherit}
.vp .note,.vp .small{font-size:.85rem;color:var(--muted);margin-top:12px}
.vp .btn.p{background:var(--blue);color:#fff} .vp .btn:not(.p){background:#fff;color:var(--blue)}
.vp .band{background:var(--soft);border-radius:20px;padding:34px}
.vp .grid{display:grid;gap:16px;margin-top:22px} .vp .g3{grid-template-columns:repeat(3,1fr)} .vp .g4{grid-template-columns:repeat(4,1fr)}
.vp .card .num{font-weight:900;font-size:1.5rem;color:var(--blue);letter-spacing:-.05em}
.vp .card .kicker{margin-bottom:6px}
.vp a.card{display:block;color:inherit} .vp a.card:hover{border-color:var(--blue)}
.vp .price{font-size:inherit;font-weight:inherit;color:inherit;letter-spacing:0}
.vp .price.hot{border:2px solid var(--blue)} .vp .tag{display:inline-block;background:var(--blue);color:#fff;border-radius:999px;padding:2px 10px;font-size:.72rem;font-weight:800}
.vp .amt{font-size:2rem;font-weight:900;color:var(--blue);letter-spacing:-.06em;margin:6px 0} .vp .amt small{font-size:.8rem;font-weight:600;color:var(--muted);letter-spacing:0}
.vp .price ul{padding-left:18px;margin:10px 0 16px;color:var(--muted);font-size:.9rem} .vp .price .btn{width:100%}
.vp .linklist{display:flex;gap:10px 22px;flex-wrap:wrap;padding:0;list-style:none} .vp .linklist a{color:var(--blue);font-weight:700}
.vp details{padding:16px 0;border-bottom:1px solid var(--line)} .vp summary{font-weight:750;cursor:pointer;color:var(--ink)}
.vp .prose{max-width:760px;font-size:1.04rem}
.vp .stats{display:flex;gap:30px;flex-wrap:wrap}.vp .stats b{display:block;font-size:1.8rem;color:var(--blue);letter-spacing:-.05em}.vp .stats span{color:var(--muted);font-size:.85rem}
.vp .btn.s{padding:10px 14px}
.vp .road{display:grid;gap:14px;margin-top:20px}
.vp .phase{display:grid;grid-template-columns:150px 1fr;gap:22px;border:1px solid var(--line);border-radius:14px;padding:22px}
.vp .phase .step{color:var(--purple);font-weight:800;text-transform:uppercase;letter-spacing:.1em;font-size:.7rem}
.vp .phase .days{font-weight:900;font-size:1.2rem;color:var(--blue);letter-spacing:-.03em;line-height:1.2;margin-top:4px}
.vp .phase h3{margin:0 0 4px;font-size:1.15rem}.vp .phase .goal{margin:0 0 8px;color:var(--ink);font-weight:600}
.vp .phase ul,.vp .plain{padding-left:18px;margin:8px 0;color:var(--muted)} .vp .plain{font-size:.92rem}
.vp .milestone{display:inline-block;margin-top:6px;background:var(--soft);border-radius:999px;padding:5px 13px;font-weight:700;font-size:.8rem;color:var(--purple)}
.vp .pains{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:20px}
.vp .pain{border:1px solid var(--line);border-radius:14px;padding:20px}
.vp .pain .thought{margin:0 0 8px;font-weight:800;font-size:1.02rem;color:var(--ink);line-height:1.35}
.vp .pain .why{margin:0 0 10px;font-size:.92rem}.vp .pain .fix{margin:0;font-size:.92rem;color:var(--ink);border-top:1px solid var(--line);padding-top:10px}.vp .pain .fix b{color:var(--blue)}
.vp .phase .alone{background:var(--soft);border-radius:10px;padding:12px 14px;margin:10px 0;font-size:.92rem;color:var(--muted)}.vp .phase .alone b{display:block;color:var(--ink);font-size:.74rem;text-transform:uppercase;letter-spacing:.08em;margin-bottom:3px}
.vp .phase .cols{display:grid;grid-template-columns:1.4fr 1fr;gap:20px;margin:10px 0}.vp .phase h4{margin:0 0 2px;font-size:.78rem;text-transform:uppercase;letter-spacing:.08em;color:var(--purple)}
@media(max-width:900px){.vp .g4{grid-template-columns:repeat(2,1fr)}}
@media(max-width:760px){.vp .pains,.vp .phase .cols{grid-template-columns:1fr}.vp .phase{grid-template-columns:1fr;gap:6px}.vp .g3,.vp .g4{grid-template-columns:1fr}.vp .hero.left{padding:30px 20px}}
</style>
