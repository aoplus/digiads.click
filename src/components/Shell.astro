---
// Page shell that matches the redesigned homepage (src/content/home.html): same palette, header, footer, analytics tag and checkout widget.
const { title, description, path, jsonld = [] } = Astro.props;
const url = new URL(path, 'https://digiads.click').href;
const WA = 'https://wa.me/917977875818?text=';
---
<!doctype html>
<html lang="en-IN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={url}><link rel="icon" href="/favicon.svg" type="image/svg+xml">
<meta property="og:title" content={title}><meta property="og:description" content={description}><meta property="og:type" content="website"><meta property="og:url" content={url}><meta name="twitter:card" content="summary">
<script async src="https://www.googletagmanager.com/gtag/js?id=G-SSRW674JW7"></script>
<script is:inline>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-SSRW674JW7');</script>
<script type="application/ld+json" is:inline set:html={JSON.stringify({'@context':'https://schema.org','@type':'Organization',name:'DigiAds.click',url:'https://digiads.click',email:'marketing@digiads.click',telephone:'+917977875818'})}></script>
{jsonld.map((j) => <script type="application/ld+json" is:inline set:html={JSON.stringify(j)}></script>)}
<style is:global>
:root{--bg:#fbfbfa;--panel:#fff;--text:#16161a;--mute:#62626b;--line:#e5e5e1;--accent:#3d3df5;--accent-ink:#fff;--soft:#f0f0fe;--ok:#0a7a4b}
@media(prefers-color-scheme:dark){:root{--bg:#121214;--panel:#1a1a1e;--text:#f1f1f3;--mute:#a0a0aa;--line:#2c2c33;--accent:#8c8cff;--accent-ink:#101014;--soft:#1f1f33;--ok:#6ee7a8}}
*{box-sizing:border-box}html{scroll-behavior:smooth}
body{margin:0;font:16px/1.6 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;background:var(--bg);color:var(--text)}
a{color:inherit}.wrap{max-width:1080px;margin:0 auto;padding:0 20px}
header.nav{position:sticky;top:0;z-index:5;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
.nav .wrap{display:flex;align-items:center;justify-content:space-between;height:60px;gap:12px}
.logo{font-weight:800;font-size:20px;letter-spacing:-.02em;text-decoration:none}.logo span{color:var(--accent)}
.nav nav{display:flex;gap:20px;font-size:14px}.nav nav a{text-decoration:none;color:var(--mute)}.nav nav a:hover{color:var(--text)}
.btn{display:inline-block;padding:11px 20px;border-radius:10px;font-weight:600;text-decoration:none;border:1px solid var(--line);background:var(--panel);font-size:15px}
.btn.p{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}.btn.s{padding:8px 14px;font-size:14px}
.hero{text-align:center;padding:72px 0 40px}
.pill{display:inline-block;font-size:13px;padding:4px 14px;border-radius:99px;background:var(--soft);color:var(--accent);font-weight:600}
.hero h1{font-size:clamp(34px,6vw,58px);line-height:1.05;letter-spacing:-.03em;margin:18px auto 16px;max-width:820px}
.hero p{font-size:18px;color:var(--mute);max-width:640px;margin:0 auto 26px}.cta{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
.note{font-size:13px;color:var(--mute);margin-top:14px}
section{padding:44px 0}h2{font-size:clamp(24px,4vw,34px);letter-spacing:-.02em;margin:0 0 8px}.lead{color:var(--mute);max-width:640px;margin:0 0 26px}
.grid{display:grid;gap:14px}.g3{grid-template-columns:repeat(auto-fit,minmax(230px,1fr))}.g4{grid-template-columns:repeat(auto-fit,minmax(200px,1fr))}
.card{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:20px}.card h3{margin:6px 0;font-size:18px}.card p{margin:0;color:var(--mute);font-size:15px}
.num{width:30px;height:30px;border-radius:50%;background:var(--accent);color:var(--accent-ink);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:14px}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:14px;text-align:center}.stats b{display:block;font-size:34px;letter-spacing:-.02em;color:var(--accent)}.stats span{color:var(--mute);font-size:14px}
.band{background:var(--soft);border-radius:18px;padding:30px}
.price{display:flex;flex-direction:column;gap:6px}.price .amt{font-size:32px;font-weight:800;letter-spacing:-.02em}.price .amt small{font-size:14px;font-weight:500;color:var(--mute)}
.price ul{margin:8px 0 14px;padding-left:18px;color:var(--mute);font-size:15px;flex:1}.price.hot{border:2px solid var(--accent)}.tag{align-self:flex-start;font-size:12px;font-weight:700;color:var(--accent);background:var(--soft);padding:2px 10px;border-radius:99px}
.small{font-size:13px;color:var(--mute)}
details{border:1px solid var(--line);border-radius:12px;background:var(--panel);padding:12px 16px;margin-bottom:10px}summary{cursor:pointer;font-weight:600}details p{margin:8px 0 0;color:var(--mute)}
footer{border-top:1px solid var(--line);padding:30px 0;color:var(--mute);font-size:14px}.foot{display:flex;gap:20px;justify-content:space-between;flex-wrap:wrap}.foot a{margin-right:14px}
@media(max-width:720px){.nav nav{display:none}.hero{padding:44px 0 26px}}
.crumbs{font-size:13px;color:var(--mute);padding-top:22px}.crumbs a{color:var(--mute)}
.hero.left{text-align:left;padding-top:40px}.hero.left h1,.hero.left p{margin-left:0;margin-right:0}.hero.left .cta{justify-content:flex-start}
.prose{max-width:720px;color:var(--mute);font-size:17px}.hero .pill{margin-bottom:2px}
.linklist{display:flex;gap:10px;flex-wrap:wrap;margin:0;padding:0;list-style:none}.linklist a{display:inline-block;padding:8px 14px;border:1px solid var(--line);border-radius:99px;text-decoration:none;font-size:14px;background:var(--panel)}.linklist a:hover{border-color:var(--accent)}
.card .kicker{font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--accent)}
</style>
</head>
<body>
<header class="nav"><div class="wrap"><a class="logo" href="/">Digi<span>Ads</span></a>
  <nav><a href="/program">90-Day Program</a><a href="/services">Services</a><a href="/#pricing">Pricing</a><a href="/for/">Industries</a><a href="/about">About</a></nav>
  <a class="btn p s" data-event="click_whatsapp" data-location="header" href={WA + encodeURIComponent("Hi DigiAds, I'd like a growth plan")} rel="noopener">Talk to DigiAds</a></div></header>
<main id="top"><div class="wrap"><slot /></div></main>
<footer><div class="wrap foot">
  <div><b>DigiAds</b> · a service of AO Plus Solutions Pvt Ltd<br>WhatsApp: <a href="https://wa.me/917977875818" rel="noopener">+91 79778 75818</a></div>
  <div><a href="/how-it-works">How it works</a><a href="/for/">Industries</a><a href="/who-we-serve">Who we serve</a><a href="/privacy">Privacy Policy</a><a href="/terms">Terms &amp; Conditions</a></div>
</div></footer>
<script src="https://shop.digiads.click/buy.js" defer></script>
<script is:inline>document.addEventListener('click',function(e){var a=e.target.closest&&e.target.closest('[data-event]');if(a&&window.gtag)gtag('event',a.dataset.event,{location:a.dataset.location,page:location.pathname})})</script>
</body></html>
