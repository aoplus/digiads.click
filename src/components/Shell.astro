---
// Industry pages use the same layout as Program and About (Base): same header, menu, fonts and footer.
// Styles live in src/styles/global.css (the design system). `bleed` lets the homepage use full-width bands with their own .wrap.
import Base from './Base.astro';
const { title, description, jsonld = [], bleed = false } = Astro.props;
---
<Base title={title} description={description}>
  <main class="vp">
    {jsonld.map((j) => <script type="application/ld+json" is:inline set:html={JSON.stringify(j)} />)}
    {bleed ? <slot /> : <div class="wrap"><slot /></div>}
  </main>
  <script src="https://shop.digiads.click/buy.js" defer></script>
</Base>
