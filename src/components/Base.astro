---
import '../styles/global.css'; import { site, wa } from '../config/site'; import { pricingData } from '../config/pricing';
const {title='DigiAds.click | Digital Growth for Agencies, Coaches, Brands and Solopreneurs', description='Build your digital presence, generate leads and measure growth with DigiAds.'}=Astro.props;
---
<!doctype html><html lang="en-IN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={new URL(Astro.url.pathname,site.url)}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta name="twitter:card" content="summary_large_image"/>{site.ga !== 'G-XXXXXXXXXX' && <script is:inline src="/consent.js" data-ga={site.ga} defer></script>}<link rel="preload" href="/fonts/inter.woff2" as="font" type="font/woff2" crossorigin/><link rel="preload" href="/fonts/plus-jakarta-sans.woff2" as="font" type="font/woff2" crossorigin/><script type="application/json" id="pricing-data" is:inline set:html={JSON.stringify(pricingData)}/><script is:inline src="/pricing.js" defer></script><script is:inline src="/consult.js" defer></script><script type="application/ld+json" is:inline set:html={JSON.stringify({'@context':'https://schema.org','@type':'Organization',name:site.name,url:site.url,email:site.email,telephone:site.phone})}/></head><body><header class="topbar"><div class="wrap nav"><a href="/" class="logo">DIGIADS<span>.CLICK</span></a><button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button><nav class="links" id="site-nav"><a href="/program">90-Day Program</a><a href="/#pricing">Pricing</a><a href="/for/">Industries</a><a href="/#ai">AI visibility</a><a href="/about">About</a></nav><div class="zone" role="group" aria-label="Currency"><button type="button" data-zone-set="IN" aria-pressed="true">IN ₹</button><button type="button" data-zone-set="INTL" aria-pressed="false">USD $</button></div><a class="btn" data-event="click_whatsapp" data-location="header" href={wa('header')}>WhatsApp Us</a></div></header><slot/><footer class="footer"><div class="wrap two"><div><div class="logo">DIGIADS<span>.CLICK</span></div><p>Intelligence Redefined. Practical digital growth for agencies, coaches, brands and solopreneurs.</p></div><div><a href="/how-it-works">How it works</a> · <a href="/who-we-serve">Who we serve</a> <a href="/compare/">Compare options</a> · <a href="/privacy">Privacy Policy</a> · <a href="#" data-consent-open>Cookie settings</a> · <a href="/terms">Terms &amp; Conditions</a><p class="legal">© 2026 AO Plus Solutions Pvt Ltd. Meta advertising budget is additional and paid directly by the client.</p></div></div></footer><script is:inline>(function(){var b=document.querySelector(".menu-btn"),n=document.getElementById("site-nav");if(!b||!n)return;function set(o){n.classList.toggle("open",o);b.setAttribute("aria-expanded",o?"true":"false");b.textContent=o?"Close":"Menu"}b.addEventListener("click",function(){set(!n.classList.contains("open"))});n.addEventListener("click",function(e){if(e.target.closest("a"))set(false)});document.addEventListener("keydown",function(e){if(e.key==="Escape")set(false)})})()</script><a class="btn sticky" data-event="click_whatsapp" data-location="sticky" href={wa('sticky')}>WhatsApp Us</a></body></html>
