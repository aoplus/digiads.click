---
import '../styles/global.css'; import { site, wa } from '../config/site';
const {title='DigiAds.click | Digital Growth for Indian SMBs', description='Build your digital presence, generate leads and measure growth with DigiAds.'}=Astro.props;
---
<!doctype html><html lang="en-IN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={new URL(Astro.url.pathname,site.url)}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta name="twitter:card" content="summary_large_image"/>{site.ga !== 'G-XXXXXXXXXX' && <script is:inline define:vars={{id:site.ga}}>window.dataLayer=window.dataLayer||[];function gtag(){{dataLayer.push(arguments)}}gtag('js',new Date());gtag('config',id);</script>}<script type="application/ld+json" is:inline set:html={JSON.stringify({'@context':'https://schema.org','@type':'Organization',name:site.name,url:site.url,email:site.email,telephone:site.phone})}/></head><body><header class="wrap nav"><a href="/" class="logo">DIGIADS<span>.CLICK</span></a><nav class="links"><a href="/program">90-Day Program</a><a href="/services">Services</a><a href="/how-it-works">How it works</a><a href="/who-we-serve">Who we serve</a><a href="/about">About + Contact</a></nav><a class="btn" data-event="click_whatsapp" data-location="header" href={wa('header')}>WhatsApp Us</a></header><slot/><footer class="footer"><div class="wrap two"><div><div class="logo">DIGIADS<span>.CLICK</span></div><p>Intelligence Redefined. Practical digital growth for Indian businesses.</p></div><div><a href="/privacy">Privacy Policy</a> · <a href="/terms">Terms &amp; Conditions</a><p class="legal">© 2026 AO Plus Solutions Pvt Ltd. Meta advertising budget is additional and paid directly by the client.</p></div></div></footer><a class="btn sticky" data-event="click_whatsapp" data-location="sticky" href={wa('sticky')}>WhatsApp Us</a><script is:inline>document.addEventListener('click',e=>{const a=e.target.closest('[data-event]');if(a&&window.gtag)gtag('event',a.dataset.event,{location:a.dataset.location,page:location.pathname,campaign:'Ganesh Chaturthi Growth Special'})})</script></body></html>
