<!doctype html><html lang="en-IN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>Ganesh Chaturthi Digital Growth Special | DigiAds.click</title><meta name="description" content="Get your business digital-ready for Ganeshotsav with DigiAds' 90-day digital growth program. Festive price ₹60,000 instead of ₹90,000. First 10 businesses only."/><link rel="canonical" href={`${site.url}/${c.slug}/`}/><meta property="og:title" content="Ganesh Chaturthi Digital Growth Special | DigiAds.click"/><meta property="og:description" content="90 days of digital growth for ₹60,000. First 10 businesses only."/><meta name="twitter:card" content="summary_large_image"/>{site.ga && <script is:inline define:vars={{id:site.ga}}>window.dataLayer=window.dataLayer||[];function gtag(){{dataLayer.push(arguments)}}gtag('js',new Date());gtag('config',id);</script>}<style is:inline>:root{--n:#07152f;--b:#1769ff;--p:#7145ee;--g:#e6a31a;--o:#f36b2b;--soft:#f5f7fc;--line:#dfe5f0}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:var(--n);line-height:1.5}.w{width:min(1120px,calc(100% - 34px));margin:auto}.hero{color:#fff;background:radial-gradient(circle at 82% 20%,#7145ee,transparent 30%),radial-gradient(circle at 67% 65%,#f36b2b44,transparent 24%),linear-gradient(135deg,#07152f,#102f7a);padding:22px 0 76px}.brand{font-weight:900;letter-spacing:-.06em}.brand b{color:#79a8ff}.tag{display:inline-block;color:#ffc85c;background:#fff2;border:1px solid #fff4;border-radius:99px;padding:7px 11px;font-weight:800;font-size:.72rem;letter-spacing:.08em}.hero-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:35px;align-items:center;padding-top:55px}h1{font-size:clamp(2.7rem,6vw,5.6rem);line-height:.9;letter-spacing:-.07em;margin:18px 0}h2{font-size:clamp(2rem,4vw,3.5rem);line-height:.98;letter-spacing:-.06em;margin:12px 0}.sub{font-size:1.1rem;color:#dce8ff;max-width:590px}.actions{display:flex;gap:11px;flex-wrap:wrap;margin-top:25px}.btn{display:inline-flex;justify-content:center;align-items:center;border-radius:9px;padding:14px 18px;font-weight:850;border:1px solid var(--b);background:var(--b);color:#fff;text-decoration:none}.btn.light{background:#fff;color:var(--n);border-color:#fff}.offer{background:#fff;color:var(--n);border-radius:18px;padding:26px;box-shadow:0 30px 70px #0005}.offer .price{font-size:3rem;line-height:1;font-weight:950;color:var(--b);letter-spacing:-.08em}.strike{text-decoration:line-through;color:#68718a;font-weight:700}.save{color:#be6300;font-weight:850}.urgency{margin-top:14px;font-size:.83rem;font-weight:800;border-top:1px solid var(--line);padding-top:13px}section{padding:74px 0}.ey{color:var(--p);letter-spacing:.1em;font-weight:850;font-size:.72rem;text-transform:uppercase}.lead{color:#5e6881;font-size:1.08rem;max-width:700px}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:15px;margin-top:30px}.card{border:1px solid var(--line);border-radius:15px;padding:21px;background:#fff}.card .num{font-size:2.1rem;color:var(--b);font-weight:950;letter-spacing:-.07em}.card h3{margin:7px 0;font-size:1rem}.card p{margin:0;color:#66708a;font-size:.92rem}.soft{background:var(--soft)}.system{display:flex;align-items:center;gap:10px;flex-wrap:wrap;font-weight:850;font-size:1.15rem}.system span{color:var(--b)}.packages{display:grid;grid-template-columns:repeat(3,1fr);gap:15px;margin-top:28px}.packages .card:nth-child(4),.packages .card:nth-child(5){grid-column:span 1}.list{list-style:none;padding:0;margin:8px 0}.list li{padding:6px 0;font-size:.92rem}.list li:before{content:'✓';color:var(--b);font-weight:950;margin-right:8px}.stats{background:var(--n);color:#fff}.stats .grid .card{background:#ffffff0b;border-color:#ffffff20}.stats .num{color:#ffc85c}.icons{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:26px}.icon{padding:16px;border:1px solid var(--line);border-radius:12px;font-weight:800;background:#fff}.icon b{font-size:1.4rem;margin-right:6px}.notice{border-left:5px solid var(--o);background:#fff6ed;padding:19px;border-radius:8px;font-weight:800;margin:26px 0}.flow{font-weight:900;font-size:1.1rem;line-height:2.1;letter-spacing:.03em}.pricebox{background:linear-gradient(135deg,#0a1b45,#253faa);color:#fff;border-radius:20px;padding:38px}.pricebox .price{font-size:4rem;font-weight:950;color:#ffc85c;letter-spacing:-.08em}.faq details{padding:17px 0;border-bottom:1px solid var(--line)}.faq summary{font-weight:800;cursor:pointer}.faq p{color:#5d6680}.contact{background:linear-gradient(110deg,#0b1838,#3347ba);color:#fff;border-radius:22px;padding:42px}.contact input,.contact textarea{padding:12px;border-radius:7px;border:0;width:100%;font:inherit;margin:5px 0}.contact form{display:grid;grid-template-columns:1fr 1fr;gap:8px}.contact textarea{grid-column:span 2}.contact button{border:0}.disclaimer{color:#69728a;font-size:.76rem}.sticky{display:none}@media(max-width:760px){.hero{padding-bottom:45px}.hero-grid{grid-template-columns:1fr;padding-top:32px}.grid{grid-template-columns:repeat(2,1fr)}.packages{grid-template-columns:1fr}.icons{grid-template-columns:repeat(2,1fr)}section{padding:55px 0}.sticky{display:flex;position:fixed;z-index:10;bottom:10px;left:10px;right:10px;gap:8px}.sticky .btn{flex:1;padding:13px 7px}.contact form{grid-template-columns:1fr}.contact textarea{grid-column:span 1}}</style><style is:inline>body{background:#fff}.hero{color:#07152f;background:#fff;padding:28px 0 38px;border-bottom:6px solid #193fb4}.hero .brand{font-size:1.45rem;color:#07152f}.hero-grid{grid-template-columns:1.35fr .65fr;gap:22px;padding-top:25px}.hero h1{color:#09142d;font-size:clamp(2.5rem,5.4vw,5rem);line-height:.92}.hero .sub{color:#44516d}.hero .tag{color:#fff;background:linear-gradient(90deg,#ce151f,#f0a600);border:0}.offer{border:2px solid #0b2157;box-shadow:none;border-radius:14px}.offer .price{background:linear-gradient(90deg,#d91a16,#f14e09);color:#fff;padding:12px;border-radius:10px;text-align:center}.offer .save{text-align:center;background:#ffd323;padding:7px;border-radius:99px}.stats{background:#071b55;padding:42px 0}.stats h2{color:#fff}.stats .grid{grid-template-columns:repeat(6,1fr)}.stats .grid .card{padding:14px 9px;text-align:center;border-radius:0}.stats .num{font-size:1.85rem}.icons{grid-template-columns:repeat(8,1fr);gap:0;border:1px solid #3849aa;border-radius:16px;overflow:hidden}.icon{border:0;border-right:1px solid #d7def1;border-radius:0;text-align:center;min-height:116px;padding:16px 8px;font-size:.77rem}.pricebox{background:linear-gradient(120deg,#071751,#143dbe);border:4px solid #6c1dd1}.contact{background:linear-gradient(100deg,#071751,#2d1a9c);border-radius:14px}(max-width:760px){.hero-grid{grid-template-columns:1fr}.hero h1{font-size:3rem}.stats .grid{grid-template-columns:repeat(2,1fr)}.icons{grid-template-columns:repeat(2,1fr)}.icon{border-bottom:1px solid #d7def1}.offer{margin-top:8px}}</style></head><body><main><section class="hero"><div class="w"><div class="brand">DIGIADS<b>.CLICK</b></div><div class="hero-grid"><div><span class="tag">GANESH CHATURTHI · GROWTH SPECIAL</span><h1>GET YOUR BUSINESS<br/>DIGITAL-READY<br/>FOR GANESHOTSAV</h1><p class="sub">A complete 90-day digital growth program to build your online presence, generate leads and help your business grow.</p><div class="actions"><a href="#pricing" class="btn" data-event="offer_cta_click" data-location="hero">CLAIM FESTIVE OFFER</a><a class="btn light" data-event="click_whatsapp" data-location="hero" href={wa('ganesh hero')}>WHATSAPP US</a></div></div><aside class="offer"><span class="tag" style="color:#a14b00;background:#fff4e5;border-color:#ffd8a9">90-DAY DIGITAL GROWTH PROGRAM</span><p class="strike">Regular price {fmt(c.regularPrice)}</p><div class="price">{fmt(c.offerPrice)}</div><p class="save">YOU SAVE {fmt(c.saving)}</p><b>TOTAL FOR 3 MONTHS</b><div class="urgency">FIRST {c.slots} BUSINESSES ONLY<br/>OFFER ENDS {c.deadline}</div></aside></div></div></section><section><div class="w"><div class="ey">Why this offer</div><h2>YOUR BUSINESS DOESN'T NEED MORE POSTS.<br/>IT NEEDS A DIGITAL GROWTH SYSTEM.</h2><p class="lead">DigiAds connects the fragmented parts: brand, digital presence, content, lead generation, CRM tracking and optimization.</p><div class="system"><span>BRAND</span> ↓ <span>DIGITAL PRESENCE</span> ↓ <span>CONTENT</span> ↓ <span>LEAD GENERATION</span> ↓ <span>CRM / TRACKING</span> ↓ <span>OPTIMIZATION</span></div></div></section><section class="soft"><div class="w"><div class="ey">What you get</div><h2>BUILD. ATTRACT. CAPTURE. OPTIMIZE.</h2><div class="grid">{pillars.map(([n,h,t,p])=><article class="card"><div class="num">{n}</div><h3>{h}<br/>{t}</h3><p>{p}</p></article>)}</div><div class="packages">{groups.map(([h,items])=><article class="card"><h3>{h}</h3><ul class="list">{items.map(i=><li>{i}</li>)}</ul></article>)}</div><p class="disclaimer">*Lead volume depends on campaign performance, audience, industry, geography and client-funded advertising spend.</p></div></section><section class="stats"><div class="w"><div class="ey" style="color:#ffc85c">The numbers</div><h2>VALUE YOU CAN SEE.</h2><div class="grid">{[['90','DAYS'],['300+','LEAD RECORDS*'],['3','LEAD CAMPAIGNS'],['20','CREATIVE ASSETS'],['36','OPTIMIZATION CHECKPOINTS'],[fmt(c.saving),'SAVING']].map(([n,t])=><div class="card"><div class="num">{n}</div><h3>{t}</h3></div>)}</div></div></section><section><div class="w"><div class="ey">Digital foundation</div><h2>LOOK PROFESSIONAL. GET FOUND. MAKE IT EASY TO CONTACT YOU.</h2><div class="icons"><div class="icon">◧ Landing Page</div><div class="icon">⌁ Custom Domain</div><div class="icon">✉ Business Email</div><div class="icon">🔵 Facebook</div><div class="icon">🌈 Instagram</div><div class="icon">🟢 WhatsApp</div><div class="icon">🔴 Google Business</div><div class="icon">◉ Analytics + SEO</div></div></div></section><section class="soft"><div class="w"><div class="ey">Lead generation</div><h2>WE GENERATE THE LEADS.<br/>YOU CLOSE THE DEALS.</h2><p class="lead">DigiAds creates and manages lead-generation campaigns designed to capture customer enquiries.</p><div class="flow">AD ↓<br/>LANDING PAGE / LEAD FORM ↓<br/>WHATSAPP / ENQUIRY ↓<br/>CRM ↓<br/>LEAD RECORD → <span style="color:#1769ff">YOUR SALES TEAM</span></div><div class="notice">DigiAds generates and captures leads. Your team handles lead follow-up, qualification, sales and conversion.</div></div></section><section><div class="w"><div class="ey">90-day optimization</div><h2>WE DON'T JUST LAUNCH.<br/>WE OPTIMIZE.</h2><div class="grid"><div class="card"><div class="num">36</div><h3>Optimization checkpoints</h3><p>Across 90 days.</p></div><div class="card"><h3>Campaign performance</h3><p>Review lead-generation performance and opportunities.</p></div><div class="card"><h3>Creative performance</h3><p>Learn what messaging and creative assets perform.</p></div><div class="card"><h3>Audience performance</h3><p>Improve targeting based on campaign signals.</p></div></div></div></section><section id="pricing" class="soft"><div class="w pricebox"><div class="ey" style="color:#ffc85c">Ganesh Chaturthi festive price</div><p class="strike" style="color:#c6d3ff">REGULAR PRICE {fmt(c.regularPrice)}</p><div class="price">{fmt(c.offerPrice)}</div><h3>YOU SAVE {fmt(c.saving)} · TOTAL FOR 3 MONTHS</h3><p>FIRST {c.slots} BUSINESSES ONLY · OFFER ENDS {c.deadline}</p><div class="notice">META ADVERTISING BUDGET IS ADDITIONAL. Paid directly by the client.</div><a class="btn light" data-event="pricing_cta_click" data-location="pricing" href={wa('pricing')}>CLAIM THE {fmt(c.saving)} FESTIVE SAVING</a></div></section><section><div class="w"><div class="ey">Who is this for?</div><h2>BUILT FOR INDIAN SMALL BUSINESSES &amp; MSMEs.</h2><div class="grid">{['Local businesses','Professional services','Retail businesses','Manufacturers','Real estate','Education / coaching','Home services','Startups'].map(x=><div class="card"><h3>{x}</h3></div>)}</div></div></section><section class="soft faq"><div class="w"><div class="ey">FAQ</div><h2>CLEAR SCOPE. TRANSPARENT PRICING.</h2>{faqs.map(([q,a])=><details data-faq><summary>{q}</summary><p>{a}</p></details>)}</div></section><section><div class="w contact"><div class="ey" style="color:#ffc85c">Ready?</div><h2>READY TO GET YOUR BUSINESS DIGITAL-READY FOR GANESHOTSAV?</h2><div class="actions"><a class="btn light" data-event="click_whatsapp" data-location="contact" href={wa('campaign contact')}>WHATSAPP NOW</a><a class="btn" data-event="click_call" data-location="contact" href={`tel:${site.phone}`}>CALL DIGIADS</a><a class="btn" data-event="click_email" data-location="contact" href={`mailto:${site.email}`}>EMAIL US</a></div><form data-form><input required name="name" placeholder="Your name"/><input required name="business" placeholder="Business name"/><input required name="phone" inputmode="tel" placeholder="WhatsApp number"/><input name="need" placeholder="What do you need?"/><textarea name="message" placeholder="Tell us about your business"></textarea><button class="btn light">CLAIM FESTIVE OFFER</button><small data-msg>For faster help, WhatsApp us at +91 98333 75149.</small></form></div></section></main><div class="sticky"><a class="btn" data-event="click_whatsapp" data-location="sticky" href={wa('campaign sticky')}>WHATSAPP US</a><a class="btn light" data-event="click_call" data-location="sticky" href={`tel:${site.phone}`}>CALL</a></div><script is:inline define:vars={{campaign:c.trackingId}}>document.addEventListener('click',e=>{const a=e.target.closest('[data-event]');if(a)window.gtag?.('event',a.dataset.event,{campaign,location:a.dataset.location,page:location.pathname,cta:a.textContent.trim()});const d=e.target.closest('[data-faq]');if(d&&d.open)window.gtag?.('event','faq_open',{campaign,page:location.pathname})});document.querySelector('[data-form]')?.addEventListener('focusin',()=>window.gtag?.('event','contact_form_start',{campaign,page:location.pathname}),{once:true});document.querySelector('[data-form]')?.addEventListener('submit',e=>{e.preventDefault();window.gtag?.('event','contact_form_submit',{campaign,page:location.pathname});document.querySelector('[data-msg]').textContent='Thanks — WhatsApp us to start your growth plan.'})</script><script is:inline>const erpForm=document.querySelector("[data-form]");erpForm?.addEventListener("submit",async e=>{e.preventDefault();const note=document.querySelector("[data-msg]"),btn=erpForm.querySelector("button");btn.disabled=true;note.textContent="Saving your enquiry…";try{const r=await fetch("/api/lead",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify(Object.fromEntries(new FormData(erpForm)))});if(!r.ok)throw Error();erpForm.reset();note.textContent="Thank you — your enquiry has been received. We’ll contact you shortly."}catch{note.textContent="We could not save this enquiry. Please WhatsApp us at +91 98333 75149."}finally{btn.disabled=false}});</script></body></html>
