import { campaignConfig as c, site, wa } from '../config/site';
const fmt=(n:number)=>`₹${n.toLocaleString('en-IN')}`;
const pillars=[['01','BUILD','Digital Foundation','Landing page, domain, business email and business profiles.'],['02','ATTRACT','Content & Lead Generation','Creative assets, campaigns and audience reach.'],['03','CAPTURE','Enquiry + WhatsApp + CRM','Make every enquiry easier to capture and organise.'],['04','OPTIMIZE','36 Performance Checkpoints','Improve campaign, creative and audience performance.']];
const groups=[['Lead generation',['300+ Lead Records*','3 Lead Campaigns','Ad Manager Setup','Campaign Monitoring']],['Content & creative',['10 Static Creatives','10 Festive / Branding Creatives','Content Calendar','Posting']],['Digital foundation',['Single Project Landing Page','Custom Domain','2 Business Email IDs','Facebook + Instagram Setup','WhatsApp Business Integration','Google Business Profile Setup','Basic SEO','Analytics & Tracking']],['CRM & lead management',['CRM Integration','Lead Tracking','Lead Capture','Enquiry Form','WhatsApp CTA']],['Optimization',['36 Optimization Checkpoints','Performance Monitoring','Campaign Optimization','Creative Optimization','Audience Optimization']]];
const faqs=[['Is the ₹60,000 price for the full 90 days?','Yes. It is the total DigiAds service fee for the complete 90-day campaign period under this seasonal offer.'],['Is advertising spend included?','No. Meta advertising spend is additional and paid directly by the client.'],['Are 300+ leads guaranteed?','No. This is the target volume of lead records/contact details captured; volume depends on campaign performance, audience, industry, geography and advertising spend.'],['Does DigiAds follow up with leads?','DigiAds generates and organizes leads. Your team handles follow-up, qualification and sales conversion.'],['What website is included?','One project-specific landing page is included, alongside custom domain setup and two business email IDs.'],['Is CRM included?','Yes. CRM integration and lead tracking are included.']];
