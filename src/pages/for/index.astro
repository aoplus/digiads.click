---
export const prerender = true;
import Shell from '../../components/Shell.astro';
import { verticals } from '../../config/verticals';
const jsonld = [{ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'DigiAds', item: 'https://digiads.click/' }, { '@type': 'ListItem', position: 2, name: 'Industries', item: 'https://digiads.click/for/' }] }];
---
<Shell title="Website, AI visibility and social audits by industry | DigiAds" description="Fixed-price audits of your website, AI readiness and social profile for Indian coaches, clinics, local services, retail, real estate and professional firms." path="/for/" jsonld={jsonld}>
  <div class="hero left">
    <span class="pill">Industries</span>
    <h1>Audits written for the way your customers find you</h1>
    <p>Different businesses lose enquiries in different places. Pick your industry to see where, and which audit to start with.</p>
  </div>
  <section><div class="grid g3">{verticals.map((v) => <a class="card" href={`/for/${v.slug}/`} style="text-decoration:none" data-event="industry_card" data-location={v.slug}><h3>{v.name}</h3><p>{v.short}</p><p style="margin-top:10px;color:var(--accent);font-weight:600">See the audits →</p></a>)}</div>
  <p class="small" style="margin-top:14px">Not on the list? The same audits work for any business with a website. <a href="https://kya.digiads.click">Start with the free AI visibility report</a>.</p></section>
</Shell>
