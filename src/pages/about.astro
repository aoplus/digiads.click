---
import Page from '../components/Page.astro'; import {site,wa} from '../config/site';
---
<Page title="About & Contact" heading="Intelligence Redefined" intro="DigiAds.click helps Indian businesses access practical digital growth: integrated foundation, lead generation and performance optimization."><div class="two"><div><h2>About DigiAds</h2><p>DigiAds.click is a brand operated by AO Plus Solutions Pvt Ltd. We focus on transparent scope, measurable execution and affordable access to connected digital growth.</p><h2>Talk to us</h2><p><a data-event="click_whatsapp" data-location="contact" href={wa('contact')}>WhatsApp: +91 98333 75149</a><br/><a data-event="click_call" data-location="contact" href={`tel:${site.phone}`}>Call: 79778 75818</a><br/><a data-event="click_email" data-location="contact" href={`mailto:${site.email}`}>{site.email}</a></p></div><form class="form" data-contact-form><h2>Get your growth plan</h2><input required placeholder="Name"/><input required placeholder="Business Name"/><input required inputmode="tel" placeholder="WhatsApp Number"/><select required><option value="">Business Type</option><option>Local Business</option><option>MSME / Manufacturer</option><option>Professional Service</option><option>Other</option></select><select required><option value="">What do you need?</option><option>90-Day Growth Program</option><option>Lead Generation</option><option>Digital Foundation</option></select><textarea placeholder="Tell us about your business"></textarea><button class="btn" type="submit">Request a callback</button><p class="legal" data-form-message>This form is ready for backend integration. For a faster response, WhatsApp us.</p></form></div><script is:inline>document.querySelector('[data-contact-form]')?.addEventListener('submit',e=>{e.preventDefault();window.gtag?.('event','contact_form_submit',{page:location.pathname});document.querySelector('[data-form-message]').textContent='Thanks — please WhatsApp us to start the conversation.'})</script></Page>
