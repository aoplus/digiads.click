---
import Base from '../components/Base.astro'; import {campaign,wa,site} from '../config/site';
const stats=[['300+','Lead Records*'],['3','Lead Campaigns'],['20','Creative Assets'],['36','Optimization Checkpoints']]; const pillars=[['Brand Foundation','Create a clear, credible identity.'],['Digital Presence','Build your landing page, profiles and tracking.'],['Lead Generation','Launch campaigns that capture enquiries.'],['Optimization','Improve what is working through 90 days.']];
---
<Base><main><section class="hero"><div class="wrap hero-grid"><div><div class="eyebrow">Intelligence Redefined</div><h1>SMART STRATEGIES.<br/>REAL GROWTH.<br/>MEASURABLE RESULTS.</h1><p>Build your digital presence. Generate leads. Grow your business.</p><div class="actions"><a class="btn" data-event="offer_cta_click" data-location="hero" href="/program">Get Your Growth Plan</a><a class="btn ghost" data-event="click_whatsapp" data-location="hero" href={wa('hero')}>WhatsApp Us</a></div></div><aside class="offer"><div class="kicker">{campaign.name}</div><h2>90-Day Digital Growth Program</h2><div><span class="strike">₹{campaign.regularPrice.toLocaleString('en-IN')}</span> <span class="price">₹{campaign.offerPrice.toLocaleString('en-IN')}</span></div><b>Save ₹{campaign.saving.toLocaleString('en-IN')}</b><small>First {campaign.slots} businesses only · Offer ends {campaign.deadline}</small></aside></div></section><section><div class="wrap"><div class="kicker">Built for momentum</div><h2 class="heading">One practical program. One measurable growth engine.</h2><div class="grid">{stats.map(([n,t])=><div class="card"><b>{n}</b><h3>{t}</h3></div>)}</div></div></section><section class="soft"><div class="wrap two"><div><div class="kicker">How growth connects</div><h2 class="heading">Reach → Lead → Track → Grow</h2><p class="lede">DigiAds generates and organizes lead records. Your team follows up, qualifies and closes the business.</p></div><div class="flow"><span>REACH</span> → <span>LEAD</span> → <span>TRACK</span> → <span>GROW</span></div></div></section><section><div class="wrap"><div class="kicker">The four pillars</div><div class="grid">{pillars.map(([h,p])=><div class="card"><h3>{h}</h3><p>{p}</p></div>)}</div></div></section><section class="wrap"><div class="cta"><h2>Ready to make your digital growth measurable?</h2><p>Start with a focused 90-day plan, not scattered activity.</p><a class="btn ghost" data-event="click_whatsapp" data-location="home-bottom" href={wa('home bottom')}>Talk to DigiAds</a></div></section></main></Base>
