---
import Base from '../components/Base.astro';
import PlatformIcon from '../components/PlatformIcon.astro';
import { navratri, wa } from '../config/site';
if (!navratri.enabled) return Astro.redirect('/');

const plans = [
  { id:'starter', name:'Social Starter', short:'Starter', price:'₹4,999', emoji:'', best:'Local shops & solo businesses',
    platforms:['facebook','instagram'],
    highlights:['28 posts a month','8 stories','Monthly report'],
    tiles:[[4,'Posts'],[2,'Reels'],[1,'Creative'],[2,'Stories']],
    perks:['Bio cleanup & highlight covers','Captions + hashtags','WhatsApp link in bio','Monthly PDF report','Email & chat support'] },
  { id:'pro', name:'Social Pro', short:'Pro', price:'₹9,999', emoji:'', featured:true, best:'Growing businesses & local brands',
    platforms:['facebook','instagram','linkedin','x'],
    highlights:['40 posts a month','4–5 page website','Google Business'],
    tiles:[[5,'Posts'],[3,'Reels'],[2,'Creatives'],[4,'Stories']],
    perks:['4–5 page website + WhatsApp button','Google Business: 1 post / week','We reply to comments & DMs','Lead forms','Detailed monthly report','Chat, email & phone support'] },
  { id:'elite', name:'Social Elite', short:'Elite', price:'₹14,999', emoji:'', best:'Scaling brands & e-commerce',
    platforms:['facebook','instagram','linkedin','x','shorts','pinterest'],
    highlights:['52 posts a month','Website + Ads','Live dashboard'],
    tiles:[[6,'Posts'],[4,'Videos'],[3,'Creatives'],['Daily','Stories']],
    perks:['6–8 page website, fully managed','2 ad campaigns (Meta / Google)','Google Business full setup','Competitor tracking','Instant WhatsApp lead alerts','Weekly live dashboard','Priority support'] },
];
const Y='✓', N='✕';
const rows = [
  ['Platforms','ICONS'],
  ['Content / month','28','40','52'],
  ['Stories / month','8','16','30'],
  ['Company website',N,'4–5 pages','6–8 pages'],
  ['Google Business',N,'1 post / wk','2 posts / wk'],
  ['Comments & DMs',N,Y,Y],
  ['Competitor tracking',N,N,Y],
  ['Paid ads',N,N,'2 campaigns'],
  ['Lead alerts','Bio link','Forms','Instant WhatsApp'],
  ['Reports','Monthly PDF','Monthly','Live weekly'],
  ['Support','Email & chat','+ Phone','Priority'],
];
---
<Base title="Navratri Offers | DigiAds.click" description="Digital marketing packages for Navratri: Social Starter ₹4,999, Social Pro ₹9,999, Social Elite ₹14,999 per month.">
<main class="nv">
  <section class="nv-hero">
    <span class="nv-lights" aria-hidden="true">{Array.from({length:26}).map((_,i)=><i style={`--d:${(i%7)*0.2}s`}></i>)}</span>
    <div class="wrap">
      <div class="nv-eyebrow">🪔 {navratri.label} 🪔</div>
      <h1>Light up your brand this Navratri</h1>
      <p>Pick a plan. We handle the rest.</p>
      <div class="nv-prices">
        {plans.map(p => (
          <div class={`nv-price ${p.featured ? 'is-featured' : ''}`}>
            {p.featured && <span class="nv-pop">⭐ Most Popular</span>}
            <div class="nv-emoji">{p.emoji}</div>
            <h3>{p.name}</h3>
            <div class="amt">{p.price}<span>/mo</span></div>
            <div class="nv-plat">{p.platforms.map(n => <PlatformIcon name={n} size={30} />)}</div>
            <ul class="nv-chips">{p.highlights.map(h => <li>{h}</li>)}</ul>
            <a class="nv-btn" href="#nv-contact" data-event="navratri_plan_click" data-location={p.id}>Choose {p.short}</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="nv-tablesec">
    <div class="wrap">
      <div class="kicker">Compare plans</div>
      <h2 class="nv-h2">What you get</h2>
      <div class="nv-scroll">
        <table class="nv-table">
          <thead><tr><th></th>{plans.map(p => <th class={p.featured ? 'f' : ''}>{p.emoji} {p.short}<br/><span>{p.price}/mo</span></th>)}</tr></thead>
          <tbody>{rows.map(r => (
            <tr><th scope="row">{r[0]}</th>
              {r[1]==='ICONS'
                ? plans.map(p => <td class={p.featured ? 'f' : ''}><span class="nv-plat sm">{p.platforms.map(n => <PlatformIcon name={n} size={24} />)}</span></td>)
                : [r[1],r[2],r[3]].map((v,i) => <td class={`${i===1?'f':''} ${v===Y?'yes':''} ${v===N?'no':''}`}>{v}</td>)}
            </tr>
          ))}</tbody>
        </table>
      </div>
      <div class="nv-learn">
        {plans.map(p => <button type="button" class="nv-btn alt" data-open={p.id}>{p.emoji} Learn more · {p.short}</button>)}
      </div>
      <div class="nv-notes">
        <div><span></span>Billed monthly in advance<small>GST extra if applicable</small></div>
        <div><span></span>Ad spend paid directly<small>Billed to your card by Meta/Google</small></div>
        <div><span></span>You approve every post<small>Weekly drafts shared in advance</small></div>
      </div>
    </div>
  </section>

  <section class="nv-cta" id="nv-contact">
    <div class="wrap">
      <h2>Let's get started 🪔</h2>
      <div class="nv-contact">
        <a href={`tel:${navratri.phone}`} data-event="click_call" data-location="navratri">📞 {navratri.phoneDisplay}</a>
        <a href={`mailto:${navratri.email}`} data-event="click_email" data-location="navratri">✉️ {navratri.email}</a>
        <a href={wa('navratri offers')} data-event="click_whatsapp" data-location="navratri"><PlatformIcon name="whatsapp" size={22} /> WhatsApp</a>
      </div>
      <a class="nv-btn big" href={navratri.formUrl} target="_blank" rel="noopener" data-event="navratri_form_click" data-location="cta">Fill the enquiry form →</a>
    </div>
  </section>

  {plans.map(p => (
    <div class="nv-modal" id={`m-${p.id}`} role="dialog" aria-modal="true" aria-labelledby={`t-${p.id}`} hidden>
      <div class="nv-sheet">
        <button type="button" class="nv-x" data-close aria-label="Close">×</button>
        <div class="nv-emoji">{p.emoji}</div>
        <h3 id={`t-${p.id}`}>{p.name}</h3>
        <div class="nv-sprice">{p.price}<span>/month</span></div>
        <p class="best">{p.best}</p>
        <div class="nv-plat">{p.platforms.map(n => <PlatformIcon name={n} size={34} />)}</div>
        <div class="nv-tiles">{p.tiles.map(([n,l]) => <div><b>{n}</b><span>{l}</span><i>{typeof n==='number' ? 'per week' : ''}</i></div>)}</div>
        <ul class="nv-perks">{p.perks.map(x => <li>{x}</li>)}</ul>
        <a class="nv-btn" href="#nv-contact" data-close>Get {p.short}</a>
      </div>
    </div>
  ))}
</main>

<script is:inline>
(function(){
  var last;
  function open(id){var m=document.getElementById('m-'+id);if(!m)return;last=document.activeElement;m.hidden=false;requestAnimationFrame(function(){m.classList.add('on')});document.body.style.overflow='hidden';m.querySelector('[data-close]').focus()}
  function close(m){m.classList.remove('on');document.body.style.overflow='';setTimeout(function(){m.hidden=true},250);if(last)last.focus()}
  document.querySelectorAll('[data-open]').forEach(function(b){b.addEventListener('click',function(){open(b.dataset.open)})});
  document.querySelectorAll('.nv-modal').forEach(function(m){
    m.addEventListener('click',function(e){if(e.target===m||e.target.closest('[data-close]'))close(m)});
  });
  document.addEventListener('keydown',function(e){if(e.key==='Escape'){var m=document.querySelector('.nv-modal.on');if(m)close(m)}});
})();
</script>
</Base>

<style is:global>
.nv{--mar:#7a0f1a;--red:#a3161f;--gold:#e6a31a;--saf:#e0742a;--cream:#fff8ec}
.nv section{padding:64px 0}
.nv-hero{position:relative;background:radial-gradient(circle at 85% 10%,#e0742a55,transparent 35%),radial-gradient(circle at 10% 90%,#e6a31a33,transparent 35%),linear-gradient(135deg,#6d0d17,#a3161f);color:#fff;text-align:center;padding-top:80px!important}
.nv-lights{position:absolute;top:0;left:0;right:0;display:flex;justify-content:space-around;pointer-events:none}
.nv-lights i{width:9px;height:9px;border-radius:50%;background:#ffd36b;margin-top:10px;box-shadow:0 0 12px 3px #ffc94d99;animation:nvTw 1.8s ease-in-out infinite;animation-delay:var(--d)}
@keyframes nvTw{50%{opacity:.35;transform:scale(.8)}}
.nv-eyebrow{letter-spacing:.18em;text-transform:uppercase;font-size:.74rem;font-weight:800;color:#ffd36b}
.nv-hero h1{font-family:Georgia,'Times New Roman',serif;font-size:clamp(2rem,5vw,3.6rem);line-height:1.05;margin:12px 0;letter-spacing:-.01em}
.nv-hero p{color:#ffe9b8;margin:0 auto;font-size:1.1rem}
.nv-prices{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:44px;text-align:center}
.nv-price{position:relative;background:#fff;color:#2a0a0e;border-radius:20px;padding:30px 20px 26px;box-shadow:0 18px 40px #0004;border-top:5px solid var(--gold);transition:transform .25s}
.nv-price:hover{transform:translateY(-6px)}
.nv-price.is-featured{transform:scale(1.05);border-top-color:var(--saf);box-shadow:0 22px 50px #0006}
.nv-price.is-featured:hover{transform:scale(1.05) translateY(-6px)}
.nv-emoji{font-size:2.2rem;line-height:1}
.nv-price h3{margin:8px 0 0;font-size:1.15rem;color:var(--mar)}
.nv-price .amt{font-size:2.8rem;font-weight:900;letter-spacing:-.05em;color:var(--red);margin:2px 0 14px}
.nv-price .amt span{font-size:1rem;font-weight:600;color:#7b5a5e;letter-spacing:0}
.nv-plat{display:flex;gap:8px;justify-content:center;flex-wrap:wrap}
.nv-plat .pi{box-shadow:0 2px 8px #0003;border:1px solid #f0e3c8}
.nv-plat.sm{gap:5px}
.nv-chips{list-style:none;padding:0;margin:16px 0 20px;display:flex;gap:6px;justify-content:center;flex-wrap:wrap}
.nv-chips li{background:#fff3da;color:var(--mar);font-size:.78rem;font-weight:700;padding:5px 11px;border-radius:99px}
.nv-pop{position:absolute;top:-14px;left:50%;transform:translateX(-50%);background:var(--saf);color:#fff;font-size:.7rem;font-weight:800;padding:5px 14px;border-radius:99px;letter-spacing:.05em;text-transform:uppercase;white-space:nowrap}
.nv-btn{display:inline-flex;align-items:center;justify-content:center;border:1px solid var(--red);background:var(--red);color:#fff;border-radius:10px;padding:12px 20px;font:inherit;font-weight:750;cursor:pointer;transition:background .2s,transform .2s}
.nv-btn:hover{background:var(--mar);transform:translateY(-1px)}
.nv-btn.alt{background:#fff;color:var(--red)}
.nv-btn.alt:hover{background:var(--cream)}
.nv-btn.big{padding:16px 32px;background:var(--gold);border-color:var(--gold);color:#2a0a0e;font-size:1.05rem}
.nv-btn.big:hover{background:#f2b53a}
.nv-price .nv-btn{width:100%}
.nv-tablesec{background:var(--cream)}
.nv-tablesec .kicker{color:var(--red)}
.nv-h2{font-family:Georgia,serif;font-size:clamp(1.7rem,3.5vw,2.4rem);margin:4px 0 20px;color:var(--mar)}
.nv-scroll{overflow-x:auto;border-radius:16px;border:1px solid #ecd9b4;background:#fff;box-shadow:0 8px 24px #7a0f1a14}
.nv-table{width:100%;min-width:560px;border-collapse:collapse;text-align:center}
.nv-table th,.nv-table td{padding:14px 12px;border-bottom:1px solid #f4e9d0}
.nv-table thead th{background:var(--mar);color:#fff;font-size:1rem;padding:16px 12px}
.nv-table thead th span{color:#ffd36b;font-weight:600;font-size:.82rem}
.nv-table thead th.f{background:var(--red)}
.nv-table tbody th{text-align:left;color:var(--mar);font-weight:700;font-size:.92rem}
.nv-table td{font-weight:650;color:#3a2427;font-size:.93rem}
.nv-table td.f{background:#fff6e3}
.nv-table td.yes{color:#1a9a4b;font-size:1.25rem;font-weight:900}
.nv-table td.no{color:#c9b9ae;font-size:1.05rem}
.nv-table tbody tr:last-child th,.nv-table tbody tr:last-child td{border-bottom:0}
.nv-learn{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin:28px 0 8px}
.nv-notes{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:30px}
.nv-notes div{background:#fff;border:1px solid #ecd9b4;border-radius:14px;padding:16px;text-align:center;font-weight:700;color:var(--mar);font-size:.92rem}
.nv-notes span{display:block;font-size:1.6rem;margin-bottom:4px}
.nv-notes small{display:block;color:#7b5a5e;font-weight:500;font-size:.78rem;margin-top:2px}
.nv-cta{background:linear-gradient(135deg,#6d0d17,#a3161f);color:#fff;text-align:center}
.nv-cta h2{font-family:Georgia,serif;font-size:clamp(1.8rem,4vw,2.6rem);margin:0}
.nv-contact{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin:24px 0 28px}
.nv-contact a{display:inline-flex;align-items:center;gap:8px;background:#ffffff1f;border:1px solid #ffffff44;padding:11px 18px;border-radius:99px;font-weight:650}
.nv-contact a:hover{background:#ffffff33}
.nv-modal{position:fixed;inset:0;z-index:50;display:grid;place-items:center;padding:18px;background:#2a0a0e00;transition:background .25s;overflow-y:auto}
.nv-modal[hidden]{display:none}
.nv-modal.on{background:#2a0a0eb3}
.nv-sheet{position:relative;width:min(520px,100%);background:#fff;border-radius:22px;padding:28px 26px 24px;border-top:6px solid var(--gold);text-align:center;opacity:0;transform:translateY(30px) scale(.94);transition:opacity .25s,transform .3s cubic-bezier(.2,.9,.3,1.2)}
.nv-modal.on .nv-sheet{opacity:1;transform:none}
.nv-sheet h3{font-family:Georgia,serif;font-size:1.7rem;margin:4px 0 0;color:var(--mar)}
.nv-sprice{font-size:2rem;font-weight:900;color:var(--red);letter-spacing:-.04em}
.nv-sprice span{font-size:.95rem;font-weight:600;color:#7b5a5e}
.nv-sheet .best{color:#6b5558;margin:2px 0 14px;font-size:.92rem}
.nv-tiles{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:18px 0}
.nv-tiles div{background:#fff3da;border-radius:12px;padding:10px 4px}
.nv-tiles b{display:block;font-size:1.5rem;color:var(--red);line-height:1.1}
.nv-tiles span{display:block;font-weight:700;font-size:.78rem;color:var(--mar)}
.nv-tiles i{display:block;font-style:normal;font-size:.66rem;color:#8a6f6f}
.nv-perks{list-style:none;padding:0;margin:0 0 20px;text-align:left;display:grid;gap:8px}
.nv-perks li{padding-left:28px;position:relative;font-size:.93rem;color:#3a2427}
.nv-perks li:before{content:'✓';position:absolute;left:0;top:0;width:20px;height:20px;border-radius:50%;background:#e4f6ea;color:#1a9a4b;font-weight:900;font-size:.8rem;display:grid;place-items:center}
.nv-sheet .nv-btn{width:100%}
.nv-x{position:absolute;top:10px;right:14px;border:0;background:none;font-size:2rem;line-height:1;color:#7b5a5e;cursor:pointer}
@media(max-width:760px){.nv-prices{grid-template-columns:1fr}.nv-price.is-featured,.nv-price.is-featured:hover{transform:none}.nv .nv-learn .nv-btn{width:100%}.nv-notes{grid-template-columns:1fr}.nv-tiles{grid-template-columns:repeat(2,1fr)}}
@media(prefers-reduced-motion:reduce){.nv-sheet,.nv-modal,.nv-lights i{transition:none;animation:none}}
</style>
